<!--
  Logging assembly. Two streams to stdout:
   - CONSOLE: the app's human-readable log. Root at INFO (2026-09-12:
     DEBUG-by-default made parquet-java log every cell of a compaction
     rewrite — minutes of log formatting per group); DEBUG stays
     available per-logger for focused debugging.
   - AUDIT: the first-class audit log (observability/Audit.kt) — one
     JSON line per event via LogstashEncoder on the dedicated
     "hoglake.audit" logger, additivity off so audit events never leak
     into the pattern console and vice versa.
-->
<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} -- %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="AUDIT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <!-- request_id is emitted as a structured argument by
                 Audit.kt; MDC inclusion would duplicate the key. -->
            <includeMdc>false</includeMdc>
        </encoder>
    </appender>

    <logger name="hoglake.audit" level="INFO" additivity="false">
        <appender-ref ref="AUDIT"/>
    </logger>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
