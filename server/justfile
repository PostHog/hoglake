# hoglake server. All JVM work runs inside the flox env (JDK 25),
# through the checked-in Gradle wrapper (pinned in
# gradle/wrapper/gradle-wrapper.properties).

_gradle := "flox activate -- ./gradlew"

# Default recipe: list all available recipes
default:
    @just --list

build:
    {{_gradle}} build --console=plain

# ktlint check (no changes)
lint:
    {{_gradle}} ktlintCheck --console=plain

# ktlint auto-format
fmt:
    {{_gradle}} ktlintFormat --console=plain

# Entire suite: unit + Testcontainers integration
test:
    {{_gradle}} test --console=plain

# Unit tests only (no Docker needed)
unit:
    {{_gradle}} test -PunitOnly --console=plain

# One test class/pattern, e.g. `just one 'com.posthog.hoglake.commit.*'`
one pattern:
    {{_gradle}} test --tests '{{pattern}}' --rerun --console=plain

# The migrations-vs-schema.sql equivalence gate on its own
schema-check:
    {{_gradle}} test --tests 'com.posthog.hoglake.SchemaEquivalenceIntegrationTest' --rerun --console=plain

# Mermaid ERD of the fold of the Flyway chain -> docs/erd/schema.mmd,
# also spliced into the root README between the erd:begin/erd:end
# markers. Atlas replays the migrations on a throwaway postgres:18
# container (Docker required). Atlas needs an atlas.sum beside the
# migrations, so it runs against a scratch copy rather than writing
# into the chain.
erd:
    #!/usr/bin/env bash
    set -euo pipefail
    scratch=$(mktemp -d)
    trap 'rm -rf "$scratch"' EXIT
    cp {{source_directory()}}/src/main/resources/db/migration/*.sql "$scratch/"
    out={{source_directory()}}/../docs/erd/schema.mmd
    mkdir -p "$(dirname "$out")"
    flox activate -d {{source_directory()}} -- atlas migrate hash --dir "file://$scratch?format=flyway"
    flox activate -d {{source_directory()}} -- atlas schema inspect \
        --url "file://$scratch?format=flyway" \
        --dev-url "docker://postgres/18/dev?search_path=public" \
        --format '{{"{{"}} mermaid . {{"}}"}}' > "$scratch/schema.mmd"
    mv "$scratch/schema.mmd" "$out"
    echo "wrote $out"
    readme={{source_directory()}}/../README.md
    awk -v mmd="$out" '
        /<!-- erd:end -->/ { skip = 0 }
        !skip { print }
        /<!-- erd:begin -->/ {
            print "```mermaid"
            while ((getline line < mmd) > 0) print line
            print "```"
            skip = 1
        }
    ' "$readme" > "$scratch/README.md"
    mv "$scratch/README.md" "$readme"
    echo "updated $readme"

# Local dev stack (Postgres 18 + MinIO). Ports overridable:
# HOGLAKE_PG_PORT / HOGLAKE_MINIO_PORT / HOGLAKE_MINIO_CONSOLE_PORT
compose-up:
    docker compose up -d

compose-down:
    docker compose down

# Run the server against the compose stack (MinIO on the default 9000;
# export HOGLAKE_S3_ENDPOINT etc. to point elsewhere)
run:
    {{_gradle}} run --console=plain

clean:
    {{_gradle}} clean --console=plain

# Swagger UI over the OpenAPI spec, live-reloading on file edits
# (volume mount). http://localhost:8090 — HOGLAKE_SWAGGER_PORT overrides.
docs:
    docker run --rm -p ${HOGLAKE_SWAGGER_PORT:-8090}:8080 \
        -e SWAGGER_JSON=/spec/hoglake.yaml \
        -v {{justfile_directory()}}/src/main/resources/openapi:/spec:ro \
        --name hoglake-swagger swaggerapi/swagger-ui

docs-down:
    docker rm -f hoglake-swagger

# Build the deployable control-plane image (multi-stage; no tests —
# CI green-gates separately).
docker-build tag="hoglake-server:dev":
    docker build -t {{tag}} {{source_directory()}}
