# name: test/sql/hoglake_read.test
# description: M2 read path against the live dev stack. Fixture:
#   run test/fixtures/read_fixture.py first (see its docstring); it
#   recreates duckext-read/ns1.points with two appended batches.
# group: [hoglake]

require hoglake

require parquet

require httpfs

require-env HOGLAKE_URL

# host:port of the dev MinIO, e.g. localhost:9000
require-env DUCKEXT_S3_ENDPOINT

# fixture-exported time-travel snapshot ids (test/fixtures/live-env.sh)
require-env DUCKEXT_POINTS_SNAP_V1

require-env DUCKEXT_POINTS_SNAP_V2

require-env DUCKEXT_POINTS_T1

require-env DUCKEXT_POINTS_T1_PLUS2

require-env DUCKEXT_EVO_SNAP_V1

statement ok
CREATE SECRET duckext_minio (TYPE s3, KEY_ID 'hoglake', SECRET 'hoglake123',
    ENDPOINT '{DUCKEXT_S3_ENDPOINT}', URL_STYLE 'path', USE_SSL false)

statement ok
ATTACH 'hoglake:duckext-read' AS lake (ENDPOINT '{HOGLAKE_URL}')

query I
SELECT count(*) FROM lake.ns1.points
----
5

query III
SELECT id, name, val FROM lake.ns1.points ORDER BY id
----
1	alpha	1.5
2	beta	-2.25
3	NULL	42.0
4	delta	NULL
5	epsilon	0.125

# stable hoglake row ids (fresh table incarnation: ids start at 0,
# assigned in commit order)
query II
SELECT rowid, id FROM lake.ns1.points ORDER BY rowid
----
0	1
1	2
2	3
3	4
4	5

# LAYOUT assertions are pinned AT the second batch's snapshot: the dev
# stack's background compactor may merge the two files at HEAD any
# time after the fixture ran (time travel keeps the historical layout,
# and compaction outputs never change VALUES — value assertions above
# stay on head)
query I
SELECT count(DISTINCT filename) FROM lake.ns1.points AT (VERSION => {DUCKEXT_POINTS_SNAP_V2})
----
2

# two snapshots wrote the data
query I
SELECT count(DISTINCT snapshot_id) FROM lake.ns1.points AT (VERSION => {DUCKEXT_POINTS_SNAP_V2})
----
2

# batch alignment: the second batch's rows carry the newer snapshot
query II
SELECT id, snapshot_id = (SELECT max(snapshot_id) FROM lake.ns1.points AT (VERSION => {DUCKEXT_POINTS_SNAP_V2}))
    FROM lake.ns1.points AT (VERSION => {DUCKEXT_POINTS_SNAP_V2}) ORDER BY id
----
1	false
2	false
3	false
4	true
5	true

# filters push into the parquet scan
query I
SELECT id FROM lake.ns1.points WHERE val > 0 ORDER BY id
----
1
3
5

query I
SELECT id FROM lake.ns1.points WHERE name IS NULL
----
3

query II
SELECT id, ts FROM lake.ns1.points WHERE ts >= '2026-02-01' ORDER BY id
----
4	2026-02-01 00:00:00
5	2026-02-02 00:00:00

# projection of a subset of columns
query I
SELECT name FROM lake.ns1.points WHERE id = 2
----
beta

# ---- partitioned table (identity(team); one file per team + a null
# partition group; partition pruning must never change results) ----

query II
SELECT team, sum(n) FROM lake.ns1.part_points GROUP BY team ORDER BY team NULLS LAST
----
a	3
b	7
c	5
NULL	6

query I
SELECT sum(n) FROM lake.ns1.part_points WHERE team = 'a'
----
3

query I
SELECT count(*) FROM lake.ns1.part_points WHERE team = 'zzz'
----
0

query I
SELECT n FROM lake.ns1.part_points WHERE team IS NULL
----
6

query I
SELECT sum(n) FROM lake.ns1.part_points WHERE team IS NOT NULL
----
15

query I
SELECT sum(n) FROM lake.ns1.part_points WHERE team >= 'b'
----
12

query I
SELECT sum(n) FROM lake.ns1.part_points WHERE team = 'a' OR team = 'c'
----
8

statement ok
DETACH lake

# ---- genuine time travel (snapshot ids exported by the fixture:
# DUCKEXT_POINTS_SNAP_V1 = the first batch's commit, V2 = the second's;
# head has 5 rows, V1 has 3 — a head-reading AT implementation FAILS
# these) ----

statement ok
ATTACH 'hoglake:duckext-read' AS lake (ENDPOINT '{HOGLAKE_URL}')

query I
SELECT id FROM lake.ns1.points AT (VERSION => {DUCKEXT_POINTS_SNAP_V1}) ORDER BY id
----
1
2
3

query I
SELECT count(*) FROM lake.ns1.points AT (VERSION => {DUCKEXT_POINTS_SNAP_V2})
----
5

# timestamp travel: the fixture exports batch1's snapshot_time in
# DuckDB-natural format (space separator, no zone); resolution must
# pick batch1, not head
query I
SELECT count(*) FROM lake.ns1.points AT (TIMESTAMP => TIMESTAMP '{DUCKEXT_POINTS_T1}')
----
3

# historical SCHEMA: points_evo had ONE column (id) at V1; the later
# ADD COLUMN must not leak into the historical read (SELECT * shape)
query I
SELECT * FROM lake.ns1.points_evo AT (VERSION => {DUCKEXT_EVO_SNAP_V1}) ORDER BY id
----
1
2
3

query II
SELECT id, v FROM lake.ns1.points_evo ORDER BY id
----
1	NULL
2	NULL
3	NULL
4	four

statement ok
DETACH lake

# ---- attach-level pins ----

statement ok
ATTACH 'hoglake:duckext-read' AS lakev
    (ENDPOINT '{HOGLAKE_URL}', SNAPSHOT_VERSION {DUCKEXT_POINTS_SNAP_V1}, READ_ONLY)

query I
SELECT count(*) FROM lakev.ns1.points
----
3

# a pinned attach is read-only: writes are refused
statement error
INSERT INTO lakev.ns1.points VALUES (99, 'z', 0.0, NULL)
----
<REGEX>:.*read-only.*

statement ok
DETACH lakev

# SNAPSHOT_TIME in DuckDB-natural format is normalized to the ISO
# instant the server requires
statement ok
ATTACH 'hoglake:duckext-read' AS laket
    (ENDPOINT '{HOGLAKE_URL}', SNAPSHOT_TIME '{DUCKEXT_POINTS_T1}', READ_ONLY)

query I
SELECT count(*) FROM laket.ns1.points
----
3

# a SNAPSHOT_TIME attach has no client-resolved snapshot id (wire gap):
# asking for one errors instead of reporting head
statement error
SELECT * FROM hoglake_current_snapshot('laket')
----
<REGEX>:.*cannot resolve a timestamp to a snapshot id.*

statement ok
DETACH laket

# ---- explicit UTC offsets are INSTANT-parsed, never dropped:
# DUCKEXT_POINTS_T1_PLUS2 is the SAME instant as T1 written at +02:00.
# An offset-dropping client reads head (5 rows) instead of 3. ----

statement ok
ATTACH 'hoglake:duckext-read' AS lakeo (ENDPOINT '{HOGLAKE_URL}')

query I
SELECT count(*) FROM lakeo.ns1.points AT (TIMESTAMP => '{DUCKEXT_POINTS_T1_PLUS2}')
----
3

statement ok
DETACH lakeo

statement ok
ATTACH 'hoglake:duckext-read' AS lakeo2
    (ENDPOINT '{HOGLAKE_URL}', SNAPSHOT_TIME '{DUCKEXT_POINTS_T1_PLUS2}', READ_ONLY)

query I
SELECT count(*) FROM lakeo2.ns1.points
----
3

statement ok
DETACH lakeo2

# ---- the PIN ITSELF forces read-only (no explicit READ_ONLY flag):
# this is the extension's enforcement, not DuckDB's flag handling ----

statement ok
ATTACH 'hoglake:duckext-read' AS lakenf
    (ENDPOINT '{HOGLAKE_URL}', SNAPSHOT_VERSION {DUCKEXT_POINTS_SNAP_V1})

query I
SELECT count(*) FROM lakenf.ns1.points
----
3

statement error
INSERT INTO lakenf.ns1.points VALUES (99, 'z', 0.0, NULL)
----
<REGEX>:.*read-only.*

statement ok
DETACH lakenf

# an explicit READ_WRITE + pin is refused at attach
statement error
ATTACH 'hoglake:duckext-read' AS lakerw
    (ENDPOINT '{HOGLAKE_URL}', SNAPSHOT_VERSION {DUCKEXT_POINTS_SNAP_V1}, READ_WRITE)
----
<REGEX>:.*read-only mode.*
