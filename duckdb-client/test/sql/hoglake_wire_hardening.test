# name: test/sql/hoglake_wire_hardening.test
# description: round-3 hardening — wire- or user-supplied values must
#   only ever produce typed, catchable errors, NEVER an
#   InternalException (which DuckDB escalates to whole-instance
#   invalidation). The fixture registers poison tables (via raw REST —
#   shapes other clients can legally create) in duckext-read/ns1:
#   bad_dec100 (decimal precision 100), bad_dec_nop (decimal, no
#   type_params), bad_cols (case-colliding columns), plus
#   duckext-sqltest/ns1.dup_path (one physical parquet registered as
#   two live logical files). Every negative test here is followed by a
#   query proving the instance is still alive.
# group: [hoglake]

require hoglake

require parquet

require httpfs

require-env HOGLAKE_URL

require-env DUCKEXT_S3_ENDPOINT

statement ok
CREATE SECRET duckext_minio (TYPE s3, KEY_ID 'hoglake', SECRET 'hoglake123',
    ENDPOINT '{DUCKEXT_S3_ENDPOINT}', URL_STYLE 'path', USE_SSL false)

statement ok
ATTACH 'hoglake:duckext-read' AS lake (ENDPOINT '{HOGLAKE_URL}')

# ---- wire metadata DuckDB cannot represent: targeted errors, never
# instance death ----

statement error
SELECT * FROM lake.ns1.bad_dec100
----
<REGEX>:.*decimal type_params outside DuckDB's range.*

query I
SELECT 'alive'
----
alive

statement error
SELECT * FROM lake.ns1.bad_dec_nop
----
<REGEX>:.*decimal type_params outside DuckDB's range.*

statement error
SELECT * FROM lake.ns1.bad_cols
----
<REGEX>:.*columns whose names differ only by case.*

# decimal params OUTSIDE the parse-bound range (negative precision):
# thrown by the parse layer as a containable typed error — the
# containment must hold for this layer too, not only the named-table
# belt
statement error
SELECT * FROM lake.ns1.bad_dec_neg
----
<REGEX>:.*precision.*out of range.*

query I
SELECT 'alive'
----
alive


# the LISTING skips unrepresentable tables and stays whole
statement ok
SHOW ALL TABLES

query I
SELECT count(*) >= 8 FROM duckdb_tables() WHERE database_name = 'lake'
----
true

query I
SELECT count(*) FROM duckdb_tables() WHERE database_name = 'lake' AND table_name LIKE 'bad_%'
----
0

# hoglake_table_info survives poisoned tables too (skips them)
query I
SELECT count(*) > 0 FROM hoglake_table_info('lake')
----
true

# listing-then-lookup order-independence: after a listing skipped the
# table, a direct lookup rethrows the TARGETED error (never "does not
# exist") and DROP IF EXISTS is loud instead of a silent no-op
statement ok
BEGIN

query I
SELECT count(*) >= 8 FROM duckdb_tables() WHERE database_name = 'lake'
----
true

statement error
SELECT * FROM lake.ns1.bad_cols
----
<REGEX>:.*columns whose names differ only by case.*

statement error
DROP TABLE IF EXISTS lake.ns1.bad_cols
----
<REGEX>:.*columns whose names differ only by case.*

statement ok
ROLLBACK

# ---- user-supplied values: typed errors, instance survives ----

statement error
ATTACH 'hoglake:duckext-read' AS badv (ENDPOINT '{HOGLAKE_URL}', SNAPSHOT_VERSION -1)
----
<REGEX>:.*SNAPSHOT_VERSION must be non-negative.*

query I
SELECT 'alive'
----
alive

statement error
SELECT count(*) FROM lake.ns1.points AT (VERSION => -1)
----
<REGEX>:.*snapshot versions are non-negative.*

query I
SELECT 'alive'
----
alive

statement error
SELECT * FROM hoglake_expire('lake', batch => -5)
----
<REGEX>:.*batch must be in.*

statement error
ALTER TABLE lake.ns1.points SET PARTITIONED BY (bucket(-4, id))
----
<REGEX>:.*bucket count must be in.*

query I
SELECT 'alive'
----
alive

# ---- reserved _hog prefix is enforced on ALTER targets, not just
# CREATE (the server does NOT enforce it — pattern-only validation) ----

statement error
ALTER TABLE lake.ns1.points ADD COLUMN _hog_evil BIGINT
----
<REGEX>:.*reserved "_hog" prefix.*

statement error
ALTER TABLE lake.ns1.points RENAME COLUMN name TO _hog_name
----
<REGEX>:.*reserved "_hog" prefix.*

# ---- a read-only or pinned attach must not create catalogs ----

statement error
ATTACH 'hoglake:duckext-hardening-ro' AS ro
    (ENDPOINT '{HOGLAKE_URL}', READ_ONLY, CREATE_IF_NOT_EXISTS true, DATA_PATH 's3://duckext-itest/hro/')
----
<REGEX>:.*CREATE_IF_NOT_EXISTS cannot be combined.*

statement error
ATTACH 'hoglake:duckext-hardening-ro' AS ro2
    (ENDPOINT '{HOGLAKE_URL}', SNAPSHOT_VERSION 1, CREATE_IF_NOT_EXISTS true, DATA_PATH 's3://duckext-itest/hro/')
----
<REGEX>:.*CREATE_IF_NOT_EXISTS cannot be combined.*

statement ok
DETACH lake

# ---- duplicate-path registrations: the catalog legally holds two
# live logical files for one physical parquet (writer retries); a
# DELETE must remove the matching rows of EVERY logical copy ----

statement ok
ATTACH 'hoglake:duckext-sqltest' AS lakes
    (ENDPOINT '{HOGLAKE_URL}', CREATE_IF_NOT_EXISTS true, DATA_PATH 's3://duckext-itest/sqltest/')

# a rowid predicate matches rows of exactly ONE logical copy: only
# that registration's DV may grow (positions are attributed per
# registration via the rowid base) — pre-fix this deleted the same
# physical position from EVERY copy, silently removing an unmatched
# committed row. rowid 4 = the second registration's a=2; the first
# registration's a=2 (rowid 1) must survive. Rerun-stable: repeat
# runs delete 0 rows and assert the same counts.
statement ok
DELETE FROM lakes.ns1.dup_path WHERE rowid = 4

query I
SELECT count(*) FROM lakes.ns1.dup_path WHERE a = 2
----
1

# a=3 is untouched by BOTH deletes in this file, so this assertion is
# stable across repeat runs (asserting a=1 here would not be: the next
# statement deletes it, and a rerun would arrive with it already gone)
query II
SELECT a, count(*) FROM lakes.ns1.dup_path WHERE a = 3 GROUP BY a ORDER BY a
----
3	2

statement ok
DELETE FROM lakes.ns1.dup_path WHERE a = 1

# no copy of a=1 survives; the untouched keys keep both copies
# (rerun-stable: a repeat run deletes 0 rows and asserts the same)
query I
SELECT count(*) FROM lakes.ns1.dup_path WHERE a = 1
----
0

query II
SELECT a, count(*) FROM lakes.ns1.dup_path WHERE a > 1 GROUP BY a ORDER BY a
----
2	1
3	2

# ---- inconsistent duplicate registration (declares 2 of the file's 3
# physical rows — the server never validates record_count against the
# parquet): DML touching the under-declared copy's third row refuses
# with a TYPED error naming file and position (pre-fix: an
# InternalException here invalidated the whole instance) ----

statement error
DELETE FROM lakes.ns1.dup_incon WHERE a = 3
----
<REGEX>:.*out of range for data file.*declares 2 rows.*

query I
SELECT 'alive'
----
alive

# ---- reserved parquet field id on a POSITIONAL registration: the
# CATALOG's explicit_row_ids flag decides the rowid source, never the
# file's own field ids. Reading the physical column here would report
# file contents (10, NULL, 30) as row ids instead of 0,1,2. Plain
# column reads still work; anything needing rowid refuses typed and
# the instance survives. ----

query I
SELECT a FROM lakes.ns1.bad_fieldid ORDER BY a
----
1
2
3

statement error
SELECT rowid FROM lakes.ns1.bad_fieldid
----
<REGEX>:.*reserved parquet field id.*WITHOUT explicit row ids.*

query I
SELECT 'alive'
----
alive

statement error
DELETE FROM lakes.ns1.bad_fieldid WHERE a = 2
----
<REGEX>:.*reserved parquet field id.*

query I
SELECT 'alive'
----
alive

query I
SELECT 'alive'
----
alive

# nothing committed: both physical copies of a=3 still read
query I
SELECT count(*) FROM lakes.ns1.dup_incon WHERE a = 3
----
2

statement ok
DETACH lakes
