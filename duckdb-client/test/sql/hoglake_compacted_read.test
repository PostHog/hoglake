# name: test/sql/hoglake_compacted_read.test
# description: reading a real server-side compaction output — a single
#   explicit_row_ids file whose stable hoglake row ids ride the
#   physical _hog_row_id column (reserved field id 2147483646), where
#   row_id_start has no positional meaning. The fixture force-compacts
#   duckext-read/ns1.points and exports DUCKEXT_POINTS_COMPACTED only
#   on success (the stack's hydrator must be alive), so this file
#   skips rather than flakes when compaction was impossible.
# group: [hoglake]

require hoglake

require parquet

require httpfs

require-env HOGLAKE_URL

require-env DUCKEXT_S3_ENDPOINT

require-env DUCKEXT_POINTS_COMPACTED

require-env DUCKEXT_POINTS_SNAP_V2

statement ok
CREATE SECRET duckext_minio (TYPE s3, KEY_ID 'hoglake', SECRET 'hoglake123',
    ENDPOINT '{DUCKEXT_S3_ENDPOINT}', URL_STYLE 'path', USE_SSL false)

statement ok
ATTACH 'hoglake:duckext-read' AS lake (ENDPOINT '{HOGLAKE_URL}')

# head is ONE compacted file
query I
SELECT count(DISTINCT filename) FROM lake.ns1.points
----
1

# row ids are PRESERVED across compaction: 0..4 in original append
# order, read from the physical _hog_row_id column (a positional
# rowid over the merged file would only coincide if the merge kept
# exact order AND started at 0 — asserting values + count catches a
# positional-fallback regression on explicit-row-id files)
query II
SELECT rowid, id FROM lake.ns1.points ORDER BY rowid
----
0	1
1	2
2	3
3	4
4	5

# values and filters over the compacted file
query I
SELECT id FROM lake.ns1.points WHERE val > 0 ORDER BY id
----
1
3
5

# the pre-compaction layout is still reachable via time travel
query I
SELECT count(DISTINCT filename) FROM lake.ns1.points AT (VERSION => {DUCKEXT_POINTS_SNAP_V2})
----
2

statement ok
DETACH lake

# ---- DISCRIMINATING explicit-row-id test: points_sorted was appended
# with a DESCENDING sort key in single-row batches and compacted under
# an ASCENDING sort order, so the sorted merge REVERSES row order —
# inside the compacted file, _hog_row_id is permuted against physical
# position. A positional-fallback regression (rowid = row_id_start +
# file_row_number) would pair rowid 0 with the HIGHEST id; the correct
# explicit read pairs rowid i with id i+1. (The plain points assertion
# above cannot catch that regression: its merge is order-preserving
# and zero-based, so both arithmetics coincide.) ----

require-env DUCKEXT_SORTED_COMPACTED

statement ok
ATTACH 'hoglake:duckext-read' AS lakesrt (ENDPOINT '{HOGLAKE_URL}')

query I
SELECT count(*) > 0 FROM (SELECT * FROM lakesrt.ns1.points_sorted)
----
true

query III
SELECT rowid, id, v FROM lakesrt.ns1.points_sorted ORDER BY rowid
----
0	1	80
1	2	70
2	3	60
3	4	50
4	5	40
5	6	30
6	7	20
7	8	10

statement ok
DETACH lakesrt
