# hoglake webui. Node toolchain from the flox env.

_npm := "flox activate -- npm"

default:
    @just --list

install:
    {{_npm}} install

# Vitest suite (mocked fetch; no server needed)
test:
    {{_npm}} test

# Dev server on :5173, proxying /v1 to HOGLAKE_API (default :8080)
dev:
    {{_npm}} run dev

build:
    {{_npm}} run build

# Build the deployable console image (static build + nginx proxying
# /v1, /healthz, /metrics, /openapi.yaml to $HOGLAKE_API).
docker-build tag="hoglake-webui:dev":
    docker build -t {{tag}} {{source_directory()}}
